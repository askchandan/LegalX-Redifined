# Backend Configuration
# Replace with your actual Render backend URL
RENDER_BACKEND_URL=https://your-legalx-backend.onrender.com

# Ollama Configuration (local by default)
# If you run Ollama locally no API key is required. If you use Ollama Cloud,
# set OLLAMA_API_KEY in your local environment (do not commit secrets).
OLLAMA_URL=http://localhost:11434

# Frontend Configuration
# This will be used by the Next.js frontend
NEXT_PUBLIC_API_URL=https://your-legalx-backend.onrender.com